<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <!-- Written by build.py from index.html.tmpl (cut 4): edit the chapters there, then python3 build.py. -->
    <script src="lib/gsap.min.js"></script>
    <script src="lib/director.js"></script>
    <style>
      @font-face { font-family: Montserrat; font-weight: 900; src: url(assets/fonts/Montserrat-Black.ttf); }
      @font-face { font-family: Montserrat; font-weight: 800; src: url(assets/fonts/Montserrat-ExtraBold.ttf); }
      @font-face { font-family: "JetBrains Mono"; font-weight: 700; src: url(assets/fonts/JetBrainsMono-Bold.ttf); }
      :root { --ground: #16161e; --lift: #1f2335; --ink: #e2e7ff; --dim: #a9b1d6; --edge: #3b4261; --accent: #7aa2f7; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { margin: 0; width: 1920px; height: 1080px; overflow: hidden; background: var(--ground); }
      #root { position: relative; width: 100%; height: 100%; color: var(--ink); background: var(--ground); overflow: hidden; }
      .display { font-family: Montserrat, sans-serif; letter-spacing: -0.025em; line-height: 1.05; }
      .mono { font-family: "JetBrains Mono", monospace; font-weight: 700; }
      .accent { color: var(--accent); }
      .zoom { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; }
      .zoom video { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
      .title, .close { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; background: radial-gradient(ellipse at 50% 38%, var(--lift) 0%, var(--ground) 72%); }
      .title img, .close > img { width: 170px; height: 170px; margin-bottom: 34px; }
      .big { font-weight: 900; font-size: 150px; letter-spacing: -0.035em; line-height: 1; }
      .sub { font-weight: 800; font-size: 50px; color: var(--dim); margin-top: 22px; }
      .ver, .url { font-size: 34px; color: var(--accent); margin-top: 26px; letter-spacing: 0.04em; }
      .omabox { display: flex; align-items: center; gap: 28px; margin-top: 64px; padding: 22px 34px; border-radius: 16px;
        box-shadow: 0 0 0 2px var(--edge); background: rgba(31, 35, 53, 0.6); }
      .omabox img { height: 52px; width: auto; }
      .ob { font-weight: 800; font-size: 32px; color: var(--ink); text-align: left; max-width: 980px; }
      .note { font-size: 24px; color: var(--dim); margin-top: 28px; letter-spacing: 0.06em; }
      .card { position: absolute; left: 150px; right: 150px; top: 330px; }
      .eb { font-size: 28px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); margin-bottom: 22px; }
      .ct { font-weight: 900; font-size: 132px; letter-spacing: -0.035em; line-height: 1; }
      .cl { font-weight: 800; font-size: 54px; color: var(--dim); margin-top: 26px; max-width: 1500px; }
      .tag { position: absolute; left: 54px; bottom: 50px; font-size: 26px; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--ink); background: rgba(16, 17, 24, 0.92); padding: 12px 20px; border-radius: 10px; box-shadow: 0 0 0 2px var(--edge); }
      .tag-br { left: auto; right: 54px; } .tag-tl { bottom: auto; top: 50px; } .tag-bl { }
      .chip { position: absolute; max-width: 900px; font-family: Montserrat, sans-serif; font-weight: 800; font-size: 46px;
        letter-spacing: -0.02em; line-height: 1.08; color: var(--ink); background: rgba(16, 17, 24, 0.94); padding: 18px 28px;
        border-radius: 14px; box-shadow: 0 0 0 3px var(--accent), 0 24px 70px rgba(0,0,0,0.55); }
      .chip-br { right: 60px; bottom: 60px; text-align: right; } .chip-tr { right: 60px; top: 60px; text-align: right; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{DURATION}}" data-width="1920" data-height="1080">
{{MARKUP}}
    </div>
    <script>
      const P = {{PLAN}};
      const FRAME = { srcW: 3840, srcH: 2160, cardW: 1920, cardH: 1080 };
      const aim = (z) => director.aim(z[0], z[1], z[2], FRAME);
      const tl = gsap.timeline({ paused: true });
      const show = (el, a, b, from) => {
        tl.fromTo(el, { opacity: 0, ...(from || { y: 12 }) }, { opacity: 1, x: 0, y: 0, duration: 0.3, ease: "power2.out" }, a);
        tl.to(el, { opacity: 0, duration: 0.2, ease: "power2.in" }, b - 0.2);
      };

      // the title
      tl.fromTo("#title-icon", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.5, ease: "power3.out" }, 0.1);
      ["#title-name", "#title-line", "#title-ver"].forEach((el, i) =>
        tl.fromTo(el, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, 0.3 + 0.25 * i));
      tl.to("#title", { opacity: 0, duration: 0.45, ease: "power2.in" }, P.title - 0.45);

      for (const ch of P.chapters) {
        ch.clips.forEach((k, n) => {
          const z = `#${ch.id}-z${n}`;
          tl.set(z, aim(k.frames[0][1]), 0);
          // a move to each later framing, then still: no overshoot, no drift
          k.frames.slice(1).forEach(([t, to]) => tl.to(z, { ...aim(to), duration: P.move, ease: "power3.inOut" }, t));
          if (k.join === "dissolve") tl.fromTo(z, { opacity: 0 }, { opacity: 1, duration: P.xfade, ease: "none" }, k.start);
          k.chips.forEach((c, i) => show(`#${ch.id}-c${n}-${i}`, c.a, c.b, { scale: 0.96 }));
        });
        // the card over the first clip, which is dimmed and blurred under it, then clears
        const z0 = `#${ch.id}-z0`, card = `#${ch.id}-card`, cEnd = ch.start + P.card;
        tl.fromTo(z0, { filter: "blur(14px) brightness(0.38)" }, { filter: "blur(0px) brightness(1)", duration: 0.5, ease: "power2.out" }, cEnd - 0.1);
        tl.fromTo(`${card} .eb`, { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, ch.start + 0.05);
        tl.fromTo(`${card} .ct`, { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, ch.start + 0.12);
        tl.fromTo(`${card} .cl`, { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, ch.start + 0.32);
        tl.to(card, { opacity: 0, duration: 0.35, ease: "power2.in" }, cEnd - 0.3);
        // the tag, out of the way while a clip shows something in its corner
        tl.set(`#${ch.id}-tag`, { opacity: 0 }, 0);
        let on = cEnd + 0.15;
        ch.clips.forEach((k) => {
          if (!k.notag) return;
          if (k.start > on) show(`#${ch.id}-tag`, on, k.start, { x: -20 });
          on = k.start + k.dur + 0.1;
        });
        tl.fromTo(`#${ch.id}-tag`, { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.3, ease: "power2.out", immediateRender: false }, on);
        tl.to(`#${ch.id}-tag`, { opacity: 0, duration: 0.2, ease: "power2.in" }, ch.end - 0.2);
      }

      // the small things: a card, then one framing each, held, straight cuts
      const M = P.montage;
      M.items.forEach((k, n) => {
        tl.set(`#small-z${n}`, aim(k.z), 0);
        if (k.label) show(`#small-l${n}`, k.start + 0.15, k.start + k.dur - 0.05, { x: k.pos === "br" ? 20 : -20 });
      });
      tl.fromTo("#small-z0", { filter: "blur(14px) brightness(0.38)" }, { filter: "blur(14px) brightness(0.38)", duration: 0.01 }, M.start);
      tl.fromTo("#small-card .eb", { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, M.start + 0.05);
      tl.fromTo("#small-card .ct", { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.5, ease: "power3.out" }, M.start + 0.12);
      tl.fromTo("#small-card .cl", { opacity: 0, y: 36 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, M.start + 0.3);
      tl.to("#small-card", { opacity: 0, duration: 0.25, ease: "power2.in" }, M.start + M.card_dur - 0.25);

      // the close, with omabox
      const C = P.close.start;
      tl.fromTo("#close", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "none" }, C);
      tl.fromTo("#close-icon", { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.5, ease: "power3.out" }, C + 0.1);
      ["#close-name", "#close-line", "#close-url", "#close-omabox", "#close-note"].forEach((el, i) =>
        tl.fromTo(el, { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.45, ease: "power3.out" }, C + 0.3 + 0.28 * i));
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
